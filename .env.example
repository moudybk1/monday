# Monday runs fully simulated with every value below left empty.
# Each numbered block switches one piece from simulated to live.
# Copy to .env (repo root). Both the server and the web app read it.

# --- web ---
API_URL=http://localhost:3001              # where Next proxies /api
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws  # the dashboard's live stream
NEXT_PUBLIC_MONAD_RPC_URL=                 # optional browser-side RPC. Do not put an RPC URL with a secret key here: it is public.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=      # optional, free at cloud.reown.com: adds phone wallets (QR) and Coinbase to the connect modal

# --- server ---
PORT=3001
WEB_ORIGIN=http://localhost:3000           # the site users sign in on; must match exactly (SIWE domain)
API_PUBLIC_URL=http://localhost:3001       # base of the decision URIs written on-chain
SESSION_SECRET=                            # required outside the simulator:  openssl rand -base64 48
MONDAY_MASTER_KEY=                         # required when VENUE=perpl: openssl rand -base64 32
DATABASE_PATH=                             # default: in-memory when simulated, ./data/monday.sqlite otherwise

# 1. Smart money: real Nansen Smart Money Perp Trades (Hyperliquid)
NANSEN_API_KEY=
NANSEN_API_URL=https://api.nansen.ai
NANSEN_POLL_SECONDS=120

# 2. Execution venue and network
VENUE=sim                                  # sim | paper (Perpl's real prices, simulated orders) | perpl
NETWORK=testnet                            # testnet | mainnet. Picks the chain and every Perpl address together.
MONAD_RPC_URL=                             # optional: your own RPC for that network. Its chain id is checked at boot.
TRADING_REQ_BUDGET_PER_MIN=40

# Real funds. NETWORK=mainnet with VENUE=perpl places live orders with real collateral.
# The server refuses to start in that mode until you confirm it here.
ALLOW_REAL_FUNDS=                          # yes
# Ceilings on every user's policy while real funds are at stake. Start small; raise on purpose.
CAP_QUOTE_USD=50
CAP_INVENTORY_USD=250
CAP_DAILY_LOSS_USD=25

# 3. Governor LLM. Optional: without a key the rule-based regimes run on their own.
LLM_PROVIDER=anthropic                     # anthropic | openai-compatible | claude-code (your Claude Code login on this machine, no key, personal use)
LLM_API_KEY=
LLM_MODEL=                                 # anthropic default: claude-opus-5-5. claude-haiku-4-5 is the low-cost choice.
LLM_BASE_URL=                              # required for openai-compatible, e.g. https://api.openai.com/v1
GOVERNOR_INTERVAL_MIN=15

# 4. On-chain policy and decision log (deploy contracts/ to the same NETWORK first)
MONDAY_REGISTRY_ADDRESS=
AGENT_LOGGER_PRIVATE_KEY=                  # pays gas for logDecision only. Keep it a separate wallet holding a little MON.

# 5. Telegram alerts (kill, loss warning, long disconnects)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics pages (/analytics). Mainnet by default. ENVIO_API_TOKEN (free at app.envio.dev/api-tokens) lets the
# indexer pull Perpl's full event history from HyperSync; without it only recent hours are indexed, over RPC.
STATS_NETWORK=mainnet
ENVIO_API_TOKEN=
