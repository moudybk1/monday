# Monday web app (Next.js). NEXT_PUBLIC_* values and the /api rewrite target are baked in at build time.
FROM node:22-slim
WORKDIR /app
# A wallet library pulls in bufferutil, which compiles from source where no prebuilt binary fits the platform.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
RUN npm ci --workspace @monday/web --workspace @monday/core --include-workspace-root
COPY tsconfig.base.json ./
COPY packages/core packages/core
COPY apps/web apps/web
ARG NETWORK=mainnet
ARG API_URL=http://server:3001
ARG STATS_URL=http://stats:3002
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_MONAD_RPC_URL=
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ENV NETWORK=$NETWORK API_URL=$API_URL STATS_URL=$STATS_URL NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL NEXT_PUBLIC_MONAD_RPC_URL=$NEXT_PUBLIC_MONAD_RPC_URL \
    NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID NEXT_TELEMETRY_DISABLED=1
RUN test -n "$NEXT_PUBLIC_WS_URL" && npm run build -w @monday/web
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "-w", "@monday/web"]
